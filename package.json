{
  "name": "agentlinkops",
  "version": "0.6.12",
  "description": "Backlink checks with dated evidence and portable results, optional repository ledgers, supplier-export imports and sync to AgentLinkOps.",
  "author": "AgentLinkOps (https://agentlinkops.com)",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "bin": {
    "agentlinkops": "bin/agentlinkops.mjs",
    "linktrail": "bin/linktrail.mjs"
  },
  "files": [
    "bin",
    "cli",
    "src",
    "shared",
    "skills",
    "templates",
    "references",
    "scripts",
    ".mcp.json",
    ".claude-plugin",
    ".codex-plugin",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE",
    "!**/__pycache__/",
    "!**/*.pyc"
  ],
  "scripts": {
    "test": "node --test --test-concurrency=4 test/*.test.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sunlover7/agentlinkops-cli.git"
  },
  "homepage": "https://agentlinkops.com/",
  "bugs": {
    "url": "https://github.com/sunlover7/agentlinkops-cli/issues"
  },
  "keywords": [
    "mcp",
    "backlinks",
    "seo",
    "citation-monitoring",
    "ai-citations",
    "agent",
    "cli",
    "link-monitoring",
    "citation-watch",
    "ledger",
    "jsonl"
  ],
  "dependencies": {
    "@modelcontextprotocol/client": "2.2.0",
    "@modelcontextprotocol/server": "2.0.0",
    "ipaddr.js": "2.2.0",
    "koffi": "3.3.2",
    "parse5": "8.0.1",
    "turndown": "^7.2.4",
    "undici": "7.29.1",
    "zod": "4.6.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  },
  "optionalDependencies": {
    "playwright-core": "^1.63.0"
  }
}
